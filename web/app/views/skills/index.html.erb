<% content_for :title, "Skills — Hermes Wingman" %>
<% content_for :header_title, "Skills" %>

<div class="card">
  <div class="card-header">
    <span class="section-title">Loaded Skills</span>
    <button class="btn btn-primary btn-sm" onclick="loadSkills()">⟳ Refresh</button>
  </div>
  <div id="skills-list" class="card-body">
    <div class="empty-state"><div class="spinner"></div></div>
  </div>
</div>

<script>
async function loadSkills() {
  const el = document.getElementById('skills-list');
  try {
    const res = await fetch('/api/skills');
    const d = await res.json();
    const skills = d.skills || [];
    if (!skills.length) { el.innerHTML = '<div class="empty-state"><div class="empty-state-icon">🔮</div><div class="empty-state-title">No Skills</div></div>'; return; }
    el.innerHTML = skills.map(s => `<div class="list-item">
      <div class="list-item-icon" style="background:${s.enabled ? 'var(--success)' : 'var(--bg-tertiary)'}22">
        <span>${s.enabled ? '✅' : '⬜'}</span>
      </div>
      <div class="list-item-body">
        <div class="list-item-title">${s.name || 'Unnamed'}</div>
        <div class="list-item-subtitle">${s.description || ''}</div>
      </div>
      <div class="list-item-action">
        <button class="btn btn-sm ${s.enabled ? 'btn-ghost' : 'btn-primary'}" onclick="toggleSkill('${s.name}')">${s.enabled ? 'Disable' : 'Enable'}</button>
      </div>
    </div>`).join('');
  } catch(e) { el.innerHTML = `<div class="empty-state"><div class="empty-state-icon">⚠️</div><div>${e.message}</div></div>`; }
}
async function toggleSkill(name) {
  await fetch('/skills/'+name+'/toggle', {method:'POST', headers:{'X-CSRF-Token':document.querySelector('[name=csrf-token]')?.content}});
  loadSkills();
}
loadSkills();
</script>