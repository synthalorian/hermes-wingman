<% content_for :title, "Chat — Hermes Wingman" %>
<% content_for :header_title, "Chat" %>

<div style="display:flex;flex-direction:column;height:calc(100vh - var(--header-h) - 48px)">
  <div id="chat-messages" class="chat-area" style="flex:1;overflow-y:auto;padding:16px">
    <div class="empty-state" style="margin-top:40px">
      <div class="empty-state-icon">💬</div>
      <div class="empty-state-title">Hermes Chat</div>
      <div class="empty-state-desc">Send a message to start conversing with Hermes.</div>
    </div>
  </div>
  <div style="padding:12px 16px;border-top:1px solid var(--border);background:var(--bg-secondary)">
    <form id="chat-form" style="display:flex;gap:8px" data-turbo="false">
      <input id="chat-input" type="text" placeholder="Type a message..." autofocus
             style="flex:1;padding:10px 14px;border-radius:8px;border:1px solid var(--border);background:var(--bg-input);color:var(--text-primary);font-size:13px">
      <button type="submit" class="btn btn-primary" style="padding:10px 20px">Send</button>
    </form>
  </div>
</div>

<script>
const messagesEl = document.getElementById('chat-messages');
const form = document.getElementById('chat-form');
const input = document.getElementById('chat-input');
let sessionId = null;

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const text = input.value.trim();
  if (!text) return;
  input.value = '';
  addMessage(text, true);
  addMessage('…', false, 'thinking');

  try {
    const res = await fetch('/chat/send_message', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name=csrf-token]')?.content},
      body: JSON.stringify({message: text, session_id: sessionId})
    });
    const data = await res.json();
    document.querySelector('.thinking')?.remove();
    if (data.response) {
      addMessage(data.response, false);
      if (data.session_id) sessionId = data.session_id;
    } else {
      addMessage('(empty response)', false);
    }
  } catch(e) {
    document.querySelector('.thinking')?.remove();
    addMessage('Error: ' + e.message, false);
  }
});

function addMessage(text, isUser, cls) {
  const empty = messagesEl.querySelector('.empty-state');
  if (empty) empty.remove();
  const div = document.createElement('div');
  div.className = 'chat-msg ' + (isUser ? 'chat-msg-user' : 'chat-msg-assistant') + (cls ? ' ' + cls : '');
  div.textContent = text;
  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}
</script>