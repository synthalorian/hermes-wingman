<% content_for :title, "Memory — Hermes Wingman" %>
<% content_for :header_title, "Memory" %>

<div class="card">
  <div class="card-header">
    <span class="section-title">Agent Memory</span>
    <button class="btn btn-primary btn-sm" onclick="loadMemory()">⟳</button>
  </div>
  <div id="memory-list" class="card-body">
    <div class="empty-state"><div class="spinner"></div></div>
  </div>
</div>
<script>
async function loadMemory() {
  const el = document.getElementById('memory-list');
  try {
    const r = await fetch('/api/memory'); const d = await r.json();
    const entries = d.entries || [];
    if (!entries.length) { el.innerHTML = '<div class="empty-state"><div class="empty-state-icon">💾</div><div class="empty-state-title">No Memory</div></div>'; return; }
    el.innerHTML = entries.map(e => `<div class="list-item"><div class="list-item-icon">📝</div><div class="list-item-body"><div class="list-item-title">${e.key}</div><div class="list-item-subtitle">${(e.content||'').substring(0,120)}</div></div></div>`).join('');
  } catch(e) { el.innerHTML = `<div class="empty-state"><div>${e.message}</div></div>`; }
}
loadMemory();
</script>