<div class="error-banner" style="padding: 20px; margin: 16px 0; border-left: 4px solid var(--error); background: rgba(255,0,64,0.05); border-radius: 0 8px 8px 0;">
  <div style="display:flex; align-items:center; gap:10px;">
    <span style="font-size:20px;">⚠</span>
    <div>
      <div style="font-size:14px; font-weight:600; color:var(--error);">Backend Unreachable</div>
      <div style="font-size:12px; color:var(--text-muted); margin-top:4px;"><%= @error %></div>
    </div>
  </div>
</div>
